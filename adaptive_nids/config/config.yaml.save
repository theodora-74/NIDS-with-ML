# ===========================================
# ADAPTIVE ML-NIDS CONFIGURATION
# ===========================================

system:
  name: "Adaptive ML-NIDS"
  version: "1.0.0"
  log_level: "INFO"
  
paths:
  data_dir: "/opt/adaptive_nids/data"
  models_dir: "/opt/adaptive_nids/models/trained"
  logs_dir: "/opt/adaptive_nids/logs"
  output_dir: "/opt/adaptive_nids/output"

# Ensemble Classifier Configuration
ensemble:
  models:
    xgboost:
      enabled: true
      weight: 0.30
      n_estimators: 200
      max_depth: 10
      learning_rate: 0.1
      subsample: 0.8
      colsample_bytree: 0.8
      
    lightgbm:
      enabled: true
      weight: 0.30
      n_estimators: 200
      max_depth: 10
      learning_rate: 0.1
      subsample: 0.8
      colsample_bytree: 0.8
      
    random_forest:
      enabled: true
      weight: 0.25
      n_estimators: 150
      max_depth: 15
      min_samples_split: 5
      min_samples_leaf: 2
      
    gradient_boosting:
      enabled: true
      weight: 0.15
      n_estimators: 100
      max_depth: 8
      learning_rate: 0.1
      subsample: 0.8

# Anomaly Detection Configuration
anomaly:
  isolation_forest:
    enabled: true
    n_estimators: 100
    contamination: 0.1
    max_samples: 0.8
    
  autoencoder:
    enabled: true
    encoding_dim: 16
    hidden_layers: [64, 32]
    epochs: 50
    batch_size: 256
    threshold_percentile: 95
    
  one_class_svm:
    enabled: true
    kernel: "rbf"
    nu: 0.1

# Feature Engineering
features:
  scaling: "standard"  # standard, minmax, robust
  handle_missing: "median"
  feature_selection:
    enabled: 
    method: "importance"
    threshold: 0.01

# Training Configuration
training:
  test_size: 0.2
  validation_size: 0.1
  random_state: 42
  cross_validation:
    enabled: true
    folds: 5

# Real-Time Detection
realtime:
  interface: "eth0"
  batch_size: 100
  flow_timeout: 60
  alert_threshold: 0.7
  
# Dataset Paths
datasets:
  cicids2017: "/opt/adaptive_nids/data/datasets/CICIDS2017"
  nslkdd: "/opt/adaptive_nids/data/datasets/NSL-KDD"
  unswnb15: "/opt/adaptive_nids/data/datasets/UNSW-NB15"
